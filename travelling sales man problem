
def tsp(graph, n):
    INF = float('inf')

    # dp[mask][i] = minimum cost to visit cities in mask
    # and finish at city i
    dp = [[INF] * n for _ in range(1 << n)]

    # Start from city 0
    dp[1][0] = 0

    for mask in range(1 << n):
        for u in range(n):
            if dp[mask][u] == INF:
                continue

            for v in range(n):
                # Visit city v if it is not visited
                if not (mask & (1 << v)):
                    new_mask = mask | (1 << v)
                    dp[new_mask][v] = min(
                        dp[new_mask][v],
                        dp[mask][u] + graph[u][v]
                    )

    # All cities visited; return to starting city
    full_mask = (1 << n) - 1
    min_cost = INF

    for i in range(1, n):
        min_cost = min(
            min_cost,
            dp[full_mask][i] + graph[i][0]
        )

    return min_cost


# Distance matrix between cities
graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

n = len(graph)
result = tsp(graph, n)

print("Minimum travelling cost:", result)
